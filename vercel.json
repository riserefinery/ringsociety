        "X-Robots-Tag": "noindex, follow"
      }
    },
    {
      "src": "/guides/how-to-choose-a-jeweler$",
      "has": [
        {
          "type": "host",
          "value": "^ringsociety\\.com$"
        }
      ],
      "headers": {
        "X-Robots-Tag": "index, follow"
      },
      "dest": "/approved-articles/how-to-choose-a-jeweler.html"
    },
    {
