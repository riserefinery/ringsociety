        "X-Robots-Tag": "noindex, follow"
      }
    },
    {
      "src": "/guides/engagement-ring-settings-and-styles$",
      "has": [
        {
          "type": "host",
          "value": "^ringsociety\\.com$"
        }
      ],
      "headers": {
        "X-Robots-Tag": "index, follow"
      },
      "dest": "/approved-articles/engagement-ring-settings-and-styles.html"
    },
    {
      "src": "/guides/how-to-choose-a-jeweler/(?:index(?:\\.html)?/?)?$",
      "status": 308,
      "headers": {
