{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/text-us-949-630-3642(?:\\.html)?/?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/diamond-card-terms-and-eligibility",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "continue": true
    },
    {
      "src": "/robots\\.txt$",
      "has": [{ "type": "host", "value": "ringsociety.com" }],
      "dest": "/robots-production.txt"
    },
    {
      "src": "/guides/how-to-buy-an-engagement-ring/(?:index\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "https://ringsociety.com/guides/how-to-buy-an-engagement-ring",
        "X-Robots-Tag": "noindex, follow"
      }
    },
    {
      "src": "/guides/how-to-buy-an-engagement-ring$",
      "has": [{ "type": "host", "value": "ringsociety.com" }],
      "headers": { "X-Robots-Tag": "index, follow" },
      "dest": "/approved-articles/how-to-buy-an-engagement-ring.html"
    },
    {
      "src": "/approved-articles/(.*)",
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/guides/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "continue": true
    },
    {
      "src": "/guides/([a-z0-9]+(?:-[a-z0-9]+)*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|twitterbot|linkedinbot|slackbot|discordbot|telegrambot|whatsapp|imessage).*"
        }
      ],
      "dest": "/api/guide-share?slug=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
