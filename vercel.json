{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/diamond-card-terms-and-eligibility",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "continue": true
    },
    {
      "src": "/guides/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "continue": true
    },
    {
      "src": "/guides/([a-z0-9]+(?:-[a-z0-9]+)*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|twitterbot|linkedinbot|slackbot|discordbot|telegrambot|whatsapp|imessage).*"
        }
      ],
      "dest": "/api/guide-share?slug=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
